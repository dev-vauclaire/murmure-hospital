{
    "settings": {
        "built_in": {
            "short_text_correction": 0,
            "space_before_punctuation": false,
            "trailing_space": true,
            "convert_text_numbers": false,
            "text_numbers_language": "fr",
            "text_numbers_threshold": 0.0
        },
        "rules": [
            {
                "id": "hospital-ponctuation-commandes-vocales",
                "name": "Nettoyage après les commandes vocales",
                "trigger": "(?i)(\\b(?:insérer[ \\t]+un[ \\t]+point(?:[ \\t]*\\p{Pd}[ \\t]*|[ \\t]+)virgule|insérer[ \\t]+un[ \\t]+point[ \\t]+d['’][ \\t]*interrogation|insérer[ \\t]+un[ \\t]+point[ \\t]+d['’][ \\t]*exclamation|insérer[ \\t]+des[ \\t]+points[ \\t]+de[ \\t]+suspension|insérer[ \\t]+une[ \\t]+barre[ \\t]+oblique|insérer[ \\t]+un[ \\t]+symbole[ \\t]+degré|insérer[ \\t]+un[ \\t]+signe[ \\t]+moins|insérer[ \\t]+un[ \\t]+signe[ \\t]+plus|insérer[ \\t]+un[ \\t]+signe[ \\t]+égal|insérer[ \\t]+un[ \\t]+signe[ \\t]+fois|insérer[ \\t]+(?:deux|2)[ \\t]+points|insérer[ \\t]+un[ \\t]+pour[ \\t]*cent|ouvrir[ \\t]+les[ \\t]+guillemets|fermer[ \\t]+les[ \\t]+guillemets|ouvrir[ \\t]+une[ \\t]+parenthèse|fermer[ \\t]+une[ \\t]+parenthèse|insérer[ \\t]+un[ \\t]+astérisque|insérer[ \\t]+une[ \\t]+virgule|ouvrir[ \\t]+une[ \\t]+accolade|fermer[ \\t]+une[ \\t]+accolade|insérer[ \\t]+une[ \\t]+arobase|ouvrir[ \\t]+un[ \\t]+crochet|fermer[ \\t]+un[ \\t]+crochet|insérer[ \\t]+un[ \\t]+point|insérer[ \\t]+un[ \\t]+tiret|insérer[ \\t]+une[ \\t]+puce|insérer[ \\t]+un[ \\t]+dièse|saut[ \\t]+de[ \\t]+ligne|nouveau[ \\t]+paragraphe|nouvelle[ \\t]+puce)\\b)(?:[ \\t]*[.,;:!?…])+[ \\t]*",
                "replacement": "${1} ",
                "enabled": true,
                "match_mode": "regex"
            },
            {
                "id": "hospital-ponctuation-avant-commandes-vocales",
                "name": "Nettoyage avant la ponctuation dictée",
                "trigger": "(?i)(?:[.,;:!?…][ \\t]*)+(\\b(?:insérer[ \\t]+un[ \\t]+point(?:[ \\t]*\\p{Pd}[ \\t]*|[ \\t]+)virgule|insérer[ \\t]+un[ \\t]+point[ \\t]+d['’][ \\t]*interrogation|insérer[ \\t]+un[ \\t]+point[ \\t]+d['’][ \\t]*exclamation|insérer[ \\t]+des[ \\t]+points[ \\t]+de[ \\t]+suspension|insérer[ \\t]+(?:deux|2)[ \\t]+points|insérer[ \\t]+une[ \\t]+virgule|insérer[ \\t]+un[ \\t]+point|insérer[ \\t]+un[ \\t]+tiret)\\b)($|[^\\p{Pd}])",
                "replacement": " ${1}${2}",
                "enabled": true,
                "match_mode": "regex"
            },
            {
                "id": "hospital-inserer-un-point-virgule-debut-ligne",
