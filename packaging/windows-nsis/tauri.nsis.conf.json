{
    "$schema": "https://schema.tauri.app/config/2",
    "bundle": {
        "targets": ["nsis"],
        "licenseFile": "../LICENSE",
        "windows": {
            "webviewInstallMode": {
                "type": "offlineInstaller",
                "silent": true
            },
            "nsis": {
                "installMode": "perMachine",
                "languages": ["French"],
                "displayLanguageSelector": false,
                "installerHooks": "../packaging/windows-nsis/hooks.nsh"
            }
        }
    }
}
